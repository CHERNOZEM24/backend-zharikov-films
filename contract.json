{
  "base_url": "http://localhost:8000",
  "resource": "movies",
  "id_field": "id",
  "missing_id": "999999",
  "list_key": null,
  "create": { "title": "Матрица", "year": 1999, "genre": "фантастика" },
  "update": { "genre": "боевик" },
  "required_field": "title",
  "errors": [
    { "body": { "title": "" }, "field": "title" },
    { "body": { "genre": "" }, "field": "genre" },
    { "body": { "year": -1 }, "field": "year" }
  ],
  "filter": { "param": "genre", "value": "фантастика", "other": "драма" },
  "text_field": "title",
  "child": {
    "resource": "ratings",
    "create": { "viewer": "Иванов", "score": 8, "review": "Отлично" },
    "parent_field": "movie_id"
  },
  "rule": {
  "description": "Один зритель оценивает фильм только один раз",
  "parent": {},
  "setup": [{ "method": "POST", "path": "/api/movies/{id}/ratings", "body": { "viewer": "Иванов", "score": 8 } }],
  "violate": { "method": "POST", "path": "/api/movies/{id}/ratings", "body": { "viewer": "Иванов", "score": 5 } },
  "expect_status": 409
},
"stats_path": "/api/movies/stats"
}

